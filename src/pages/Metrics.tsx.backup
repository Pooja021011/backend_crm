                    <Bar dataKey="outbound" fill="#3b82f6" name="Outbound Calls" radius={[4, 4, 0, 0]} />
                    <Bar dataKey="inbound" fill="#10b981" name="Inbound Calls" radius={[4, 4, 0, 0]} />
