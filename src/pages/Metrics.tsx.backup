              {transactionsLoading && (
                <Card className="p-8 text-center">
                  <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-orange-600 mx-auto mb-4"></div>
                  <p className="text-gray-600">Loading transactions metrics...</p>
                </Card>
              )}

              {/* Error State */}
              {transactionsError && (
                <Card className="p-8 text-center border-red-200 bg-red-50">
                  <div className="text-red-600 mb-2">⚠️ Error Loading Data</div>
                  <p className="text-red-700">{transactionsError}</p>
                </Card>
              )}

              {/* Transactions Metrics Content - Dynamic based on data availability */}
              {!transactionsLoading && !transactionsError && (
                <div className="space-y-8">
                  {/* Row 1 - Pipeline Metrics */}
                  <div>
                    <h3 className="text-lg font-semibold text-gray-900 mb-4">📋 Transaction Pipeline</h3>
                    <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                      {/* Total Properties in Pipeline */}
                      <Card className="p-8 hover:shadow-lg transition-shadow bg-gradient-to-br from-orange-50 to-white border border-orange-200">
                        <div className="text-center space-y-4">
                          <h3 className="text-sm font-bold text-orange-600 uppercase tracking-wider">Total Properties in Pipeline</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                              <circle cx="60" cy="60" r="50" stroke="#e5e7eb" strokeWidth="8" fill="none" />
                              <circle
                                cx="60" cy="60" r="50" stroke="#f97316" strokeWidth="8" fill="none"
                                strokeLinecap="round"
                                strokeDasharray={`${((transactionsData?.pipeline?.totalProperties || 0) / Math.max(transactionsData?.pipeline?.totalProperties || 1, 40)) * 314} 314`}
                                className="transition-all duration-1000 ease-out"
                              />
                            </svg>
                            <div className="absolute inset-0 flex items-center justify-center">
                              <div className="text-center">
                                <div className="text-2xl font-black text-orange-600">
                                  {transactionsData?.pipeline?.totalProperties || '—'}
                                </div>
                                <div className="text-xs text-gray-600 font-medium">Total</div>
                              </div>
                            </div>
                          </div>
                          <div className="text-lg font-bold text-orange-900">
                            {transactionsData?.pipeline?.totalProperties || 0}
                          </div>
                          <p className="text-xs text-orange-600">Properties in Transaction</p>
                        </div>
                      </Card>

                      {/* Total Clear to Close */}
                      <Card className="p-8 hover:shadow-lg transition-shadow bg-gradient-to-br from-green-50 to-white border border-green-200">
                        <div className="text-center space-y-4">
                          <h3 className="text-sm font-bold text-green-600 uppercase tracking-wider">Clear to Close</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                              <circle cx="60" cy="60" r="50" stroke="#e5e7eb" strokeWidth="8" fill="none" />
                              <circle
                                cx="60" cy="60" r="50" stroke="#10b981" strokeWidth="8" fill="none"
                                strokeLinecap="round"
                                strokeDasharray={`${((transactionsData?.pipeline?.clearToClose || 0) / Math.max(transactionsData?.pipeline?.totalProperties || 1, 1)) * 314} 314`}
                                className="transition-all duration-1000 ease-out"
                              />
                            </svg>
                            <div className="absolute inset-0 flex items-center justify-center">
                              <div className="text-center">
                                <div className="text-2xl font-black text-green-600">
                                  {transactionsData?.pipeline?.clearToClose || '—'}
                                </div>
                                <div className="text-xs text-gray-600 font-medium">Clear</div>
                              </div>
                            </div>
                          </div>
                          <div className="text-lg font-bold text-green-900">
                            {transactionsData?.pipeline?.clearToClose || 0}
                          </div>
                          <p className="text-xs text-green-600">Clear to Close</p>
                        </div>
                      </Card>

                      {/* % Clear to Close */}
                      <Card className="p-8 hover:shadow-lg transition-shadow bg-gradient-to-br from-amber-50 to-white border border-amber-200">
                        <div className="text-center space-y-4">
                          <h3 className="text-sm font-bold text-amber-600 uppercase tracking-wider">Clear to Close Rate</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                              <circle cx="60" cy="60" r="50" stroke="#e5e7eb" strokeWidth="8" fill="none" />
                              <circle
                                cx="60" cy="60" r="50" stroke="#f59e0b" strokeWidth="8" fill="none"
                                strokeLinecap="round"
                                strokeDasharray={`${(transactionsData?.pipeline?.clearToCloseRate || 0) / 100 * 314} 314`}
                                className="transition-all duration-1000 ease-out"
                              />
                            </svg>
                            <div className="absolute inset-0 flex items-center justify-center">
                              <div className="text-center">
                                <div className="text-2xl font-black text-amber-600">
                                  {transactionsData?.pipeline?.clearToCloseRate || '—'}%
                                </div>
                                <div className="text-xs text-gray-600 font-medium">Rate</div>
                              </div>
                            </div>
                          </div>
                          <div className="text-lg font-bold text-amber-900">
                            {transactionsData?.pipeline?.clearToCloseRate || 0}%
                          </div>
                          <p className="text-xs text-amber-600">Clear to Close Rate</p>
                        </div>
                      </Card>
                    </div>
                  </div>

                  {/* Row 2 - Financial & Quality Metrics */}
                  <div>
                    <h3 className="text-lg font-semibold text-gray-900 mb-4">💰 Financial Performance & Quality</h3>
                    <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
                      {/* Projected Profit */}
                      <Card className="p-8 hover:shadow-lg transition-shadow bg-gradient-to-br from-blue-50 to-white border border-blue-200">
                        <div className="text-center space-y-4">
                          <h3 className="text-sm font-bold text-blue-600 uppercase tracking-wider">Projected Profit</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                              <circle cx="60" cy="60" r="50" stroke="#e5e7eb" strokeWidth="8" fill="none" />
                              <circle
                                cx="60" cy="60" r="50" stroke="#3b82f6" strokeWidth="8" fill="none"
                                strokeLinecap="round"
                                strokeDasharray={`${((transactionsData?.financial?.projectedProfit || 0) / Math.max(transactionsData?.financial?.projectedProfit || 1, 1000000)) * 314} 314`}
                                className="transition-all duration-1000 ease-out"
                              />
                            </svg>
                            <div className="absolute inset-0 flex items-center justify-center">
                              <div className="text-center">
                                <div className="text-xl font-black text-blue-600">
                                  ${Math.round((transactionsData?.financial?.projectedProfit || 0) / 1000)}K
                                </div>
                                <div className="text-xs text-gray-600 font-medium">Projected</div>
                              </div>
                            </div>
                          </div>
                          <div className="text-lg font-bold text-blue-900">
                            {transactionsData?.financial?.projectedProfit ? 
                              Math.round((transactionsData.financial.projectedProfit / 1000000) * 100) : 0}%
                          </div>
                          <p className="text-xs text-blue-600">
                            ${new Intl.NumberFormat().format(transactionsData?.financial?.projectedProfit || 0)}
                          </p>
                        </div>
                      </Card>

                      {/* Total Deals Closed */}
                      <Card className="p-8 hover:shadow-lg transition-shadow bg-gradient-to-br from-emerald-50 to-white border border-emerald-200">
                        <div className="text-center space-y-4">
                          <h3 className="text-sm font-bold text-emerald-600 uppercase tracking-wider">Total Deals Closed</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                              <circle cx="60" cy="60" r="50" stroke="#e5e7eb" strokeWidth="8" fill="none" />
                              <circle
                                cx="60" cy="60" r="50" stroke="#10b981" strokeWidth="8" fill="none"
                                strokeLinecap="round"
                                strokeDasharray={`${((transactionsData?.financial?.dealsClosed || 0) / Math.max(transactionsData?.pipeline?.totalProperties || 1, 1)) * 314} 314`}
                                className="transition-all duration-1000 ease-out"
                              />
                            </svg>
                            <div className="absolute inset-0 flex items-center justify-center">
                              <div className="text-center">
                                <div className="text-2xl font-black text-emerald-600">
                                  {transactionsData?.financial?.dealsClosed || '—'}
                                </div>
                                <div className="text-xs text-gray-600 font-medium">Closed</div>
                              </div>
                            </div>
                          </div>
                          <div className="text-lg font-bold text-emerald-900">
                            {transactionsData?.financial?.closureRate || 0}%
                          </div>
                          <p className="text-xs text-emerald-600">Deals Closed</p>
                        </div>
                      </Card>

                      {/* Closed Profit */}
                      <Card className="p-8 hover:shadow-lg transition-shadow bg-gradient-to-br from-teal-50 to-white border border-teal-200">
                        <div className="text-center space-y-4">
                          <h3 className="text-sm font-bold text-teal-600 uppercase tracking-wider">Closed Profit</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                              <circle cx="60" cy="60" r="50" stroke="#e5e7eb" strokeWidth="8" fill="none" />
                              <circle
                                cx="60" cy="60" r="50" stroke="#14b8a6" strokeWidth="8" fill="none"
                                strokeLinecap="round"
                                strokeDasharray={`${((transactionsData?.financial?.closedProfit || 0) / Math.max(transactionsData?.financial?.closedProfit || 1, 800000)) * 314} 314`}
                                className="transition-all duration-1000 ease-out"
                              />
                            </svg>
                            <div className="absolute inset-0 flex items-center justify-center">
                              <div className="text-center">
                                <div className="text-xl font-black text-teal-600">
                                  ${Math.round((transactionsData?.financial?.closedProfit || 0) / 1000)}K
                                </div>
                                <div className="text-xs text-gray-600 font-medium">Realized</div>
                              </div>
                            </div>
                          </div>
                          <div className="text-lg font-bold text-teal-900">
                            {transactionsData?.financial?.closedProfit ? 
                              Math.round((transactionsData.financial.closedProfit / 800000) * 100) : 0}%
                          </div>
                          <p className="text-xs text-teal-600">
                            ${new Intl.NumberFormat().format(transactionsData?.financial?.closedProfit || 0)}
                          </p>
                        </div>
                      </Card>

                      {/* Leads Mishandled */}
                      <Card className={`p-8 hover:shadow-lg transition-shadow bg-gradient-to-br border ${
                        (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'from-red-50 to-white border-red-200' :
                        (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'from-yellow-50 to-white border-yellow-200' :
                        'from-green-50 to-white border-green-200'
                      }`}>
                        <div className="text-center space-y-4">
                          <h3 className={`text-sm font-bold uppercase tracking-wider ${
                            (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'text-red-600' :
                            (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'text-yellow-600' :
                            'text-green-600'
                          }`}>Leads Mishandled</h3>
                          <div className="relative w-32 h-32 mx-auto">
                            <div className={`w-32 h-32 rounded-full flex items-center justify-center border-4 ${
                              (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'bg-red-100 border-red-300' :
                              (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'bg-yellow-100 border-yellow-300' :
                              'bg-green-100 border-green-300'
                            }`}>
                              <div className="text-center">
                                <div className={`text-3xl font-black ${
                                  (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'text-red-600' :
                                  (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'text-yellow-600' :
                                  'text-green-600'
                                }`}>
                                  {transactionsData?.quality?.leadsRiskCount || 0}
                                </div>
                                <div className={`text-xs font-medium ${
                                  (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'text-red-700' :
                                  (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'text-yellow-700' :
                                  'text-green-700'
                                }`}>
                                  Mishandled
                                </div>
                              </div>
                            </div>
                          </div>
                          <div className={`text-lg font-bold ${
                            (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'text-red-900' :
                            (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'text-yellow-900' :
                            'text-green-900'
                          }`}>
                            {transactionsData?.quality?.leadsRiskLevel === 'high' ? 'High Risk' :
                             transactionsData?.quality?.leadsRiskLevel === 'medium' ? 'Medium Risk' :
                             'Low Risk'}
                          </div>
                          <p className={`text-xs ${
                            (transactionsData?.quality?.leadsRiskLevel === 'high') ? 'text-red-600' :
                            (transactionsData?.quality?.leadsRiskLevel === 'medium') ? 'text-yellow-600' :
                            'text-green-600'
                          }`}>
                            {transactionsData?.quality?.riskReason || 'Coordination Issues'}
                          </p>
                        </div>
                      </Card>
                    </div>
                  </div>
                </div>
              )}

              {/* No Data State */}
              {!transactionsLoading && !transactionsError && !transactionsData && (
                <Card className="p-8 text-center">
                  <div className="space-y-4">
                    <div className="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto">
                      <FileText className="w-8 h-8 text-gray-400" />
                    </div>
                    <div>
                      <h3 className="text-lg font-semibold text-gray-900 mb-2">No Transactions Data</h3>
                      <p className="text-gray-600">
                        No transactions data available for the selected period and scope.
                      </p>
                      <p className="text-sm text-gray-500 mt-2">
                        Try adjusting your filters or check back later.
                      </p>
                    </div>
                  </div>
                </Card>
              )}
            </>
          )}
        </div>
      )}

      {activeTab === "transaction-coordinator" && (
        <div className="space-y-6">
          <div className="flex items-center justify-between">
            <div>
              <h2 className="text-2xl font-bold text-gray-900">Transaction Coordinator Metrics</h2>
              <p className="text-sm text-gray-600">Track transaction coordination performance</p>
            </div>
            <Select defaultValue="all-users">
              <SelectTrigger className="w-48">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all-users">All Users (Default)</SelectItem>
                <SelectItem value="coordinator-1">Transaction Coordinator 1</SelectItem>
                <SelectItem value="coordinator-2">Transaction Coordinator 2</SelectItem>
              </SelectContent>
            </Select>
          </div>
          
          <div className="text-center py-12">
            <p className="text-gray-500">Transaction Coordinator metrics will be configured here</p>
          </div>
        </div>
      )}

      {/* Acquisitions Leaderboard Tab */}
      {activeTab === "acquisitions-leaderboard" && (
        <div className="space-y-6">
          {/* Role-based Access Control */}
          {!(isAdmin || isExecutive || isManager || isACQ) ? (
            <Card className="p-8 text-center border-red-200 bg-red-50">
              <div className="space-y-4">
                <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto">
                  <Trophy className="w-8 h-8 text-red-400" />
                </div>
                <div>
                  <h3 className="text-lg font-semibold text-red-900 mb-2">Access Restricted</h3>
                  <p className="text-red-700">
                    Acquisitions Leaderboard is available to Admin, Executive, Manager, and Acquisitions Agent roles only.
                  </p>
                  <p className="text-sm text-red-600 mt-2">
                    Contact your administrator for access to leaderboard rankings.
                  </p>
                </div>
              </div>
            </Card>
          ) : (
            <>
              {/* Header */}
          <div className="flex items-center justify-between">
            <div>
              <h2 className="text-2xl font-bold text-gray-900">Acquisitions Leaderboard</h2>
                  <p className="text-sm text-gray-600">
                    {isACQ ? 'See where you rank among the acquisitions team' : 
                     'Rankings and performance comparison for acquisitions team'}
                  </p>
            </div>
            <div className="flex items-center gap-4">
                  <Select value={acqLeaderboardPeriod} onValueChange={setAcqLeaderboardPeriod}>
                <SelectTrigger className="w-32">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="this-month">This Month</SelectItem>
                  <SelectItem value="last-month">Last Month</SelectItem>
                  <SelectItem value="this-quarter">This Quarter</SelectItem>
                  <SelectItem value="this-year">This Year</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
          
              {/* Role-based Access Info */}
              <Card className="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 border-blue-200">
                <div className="flex items-center justify-between">
                  <div className="flex items-center space-x-3">
                    <Trophy className="w-5 h-5 text-blue-600" />
                    <div>
                      <span className="text-sm font-medium text-gray-700">Leaderboard View: </span>
                      <span className="text-sm font-semibold text-gray-900">
                        {isACQ ? 'Personal Ranking' : 'Team Rankings'}
                      </span>
          </div>
                  </div>
                  <div className="text-xs text-gray-600">
                    {isAdmin ? 'Admin' : isExecutive ? 'Executive' : isManager ? 'Manager' : 
                     isACQ ? 'ACQ Agent' : 'User'} Access
                  </div>
                </div>
              </Card>

              {/* Loading State */}
              {acqLeaderboardLoading && (
                <Card className="p-8 text-center">
                  <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4"></div>
                  <p className="text-gray-600">Loading acquisitions leaderboard...</p>
                </Card>
              )}

              {/* Error State */}
              {acqLeaderboardError && (
                <Card className="p-8 text-center border-red-200 bg-red-50">
                  <div className="text-red-600 mb-2">⚠️ Error Loading Leaderboard</div>
                  <p className="text-red-700">{acqLeaderboardError}</p>
                </Card>
              )}

              {/* Leaderboard Content */}
              {!acqLeaderboardLoading && !acqLeaderboardError && (
                <div className="space-y-6">
                  {/* Performance Leaderboard */}
                  <Card className="overflow-hidden">
                    <div className="p-6 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-indigo-50">
                      <div className="flex items-center justify-between">
                        <div>
                          <h3 className="text-lg font-semibold text-gray-900 flex items-center gap-2">
                            <Trophy className="w-5 h-5 text-yellow-500" />
                            Performance Rankings
                          </h3>
                          <p className="text-sm text-gray-600 mt-1">
                            Ranked by Contracts Signed, Projected Profit, Leads per Contract, minus mishandled leads
                          </p>
                        </div>
                        <div className="text-right">
                          <div className="text-sm text-gray-500">Total Agents</div>
                          <div className="text-xl font-bold text-gray-900">{acqLeaderboardData.length}</div>
                        </div>
                      </div>
                    </div>
                    
                    <div className="overflow-x-auto">
                      <table className="w-full">
                        <thead className="bg-gray-50 border-b border-gray-200">
                          <tr>
                            <th className="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rank</th>
                            <th className="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agent</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Contracts</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Projected Profit</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Leads/Contract</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Mishandled</th>
                          </tr>
                        </thead>
                        <tbody className="bg-white divide-y divide-gray-200">
                          {acqLeaderboardData.map((agent, index) => (
                            <tr 
                              key={agent.userId} 
                              className={`hover:bg-gray-50 transition-colors ${
                                isACQ && agent.userId === user?.id ? 'bg-blue-50 ring-2 ring-blue-200' : ''
                              } ${
                                index === 0 ? 'bg-gradient-to-r from-yellow-50 to-amber-50' :
                                index === 1 ? 'bg-gradient-to-r from-gray-50 to-slate-50' :
                                index === 2 ? 'bg-gradient-to-r from-orange-50 to-amber-50' : ''
                              }`}
                            >
                              <td className="px-6 py-4 whitespace-nowrap">
                                <div className="flex items-center">
                                  {index === 0 && <span className="text-2xl mr-2">🥇</span>}
                                  {index === 1 && <span className="text-2xl mr-2">🥈</span>}
                                  {index === 2 && <span className="text-2xl mr-2">🥉</span>}
                                  <span className={`text-sm font-semibold ${
                                    index < 3 ? 'text-gray-900' : 'text-gray-600'
                                  }`}>
                                    #{index + 1}
                                  </span>
                                </div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap">
                                <div className="flex items-center">
                                  <div className={`w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-semibold mr-3 ${
                                    index === 0 ? 'bg-yellow-500' :
                                    index === 1 ? 'bg-gray-400' :
                                    index === 2 ? 'bg-orange-400' : 'bg-blue-500'
                                  }`}>
                                    {agent.name.split(' ').map((n: string) => n[0]).join('').toUpperCase()}
                                  </div>
                                  <div>
                                    <div className="text-sm font-medium text-gray-900 flex items-center gap-2">
                                      {agent.name}
                                      {isACQ && agent.userId === user?.id && (
                                        <span className="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">You</span>
                                      )}
                                    </div>
                                    <div className="text-sm text-gray-500">{agent.email}</div>
                                  </div>
                                </div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className={`text-lg font-bold ${
                                  index < 3 ? 'text-gray-900' : 'text-gray-600'
                                }`}>
                                  {agent.totalScore}
                                </div>
                                <div className="text-xs text-gray-500">points</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-sm font-semibold text-gray-900">{agent.contractsSigned}</div>
                                <div className="text-xs text-gray-500">signed</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-sm font-semibold text-green-600">
                                  ${new Intl.NumberFormat().format(agent.projectedProfit)}
                                </div>
                                <div className="text-xs text-gray-500">projected</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-sm font-semibold text-blue-600">{agent.leadsPerContract}</div>
                                <div className="text-xs text-gray-500">ratio</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className={`text-sm font-semibold ${
                                  agent.mishandledLeads > 5 ? 'text-red-600' :
                                  agent.mishandledLeads > 2 ? 'text-yellow-600' : 'text-green-600'
                                }`}>
                                  {agent.mishandledLeads}
                                </div>
                                <div className="text-xs text-gray-500">leads</div>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </Card>

                  {/* Communications Leaderboard */}
                  <Card className="overflow-hidden">
                    <div className="p-6 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                      <div className="flex items-center justify-between">
                        <div>
                          <h3 className="text-lg font-semibold text-gray-900 flex items-center gap-2">
                            <MessageSquare className="w-5 h-5 text-green-500" />
                            Communications Rankings
                          </h3>
                          <p className="text-sm text-gray-600 mt-1">
                            Ranked by total communications activity (calls, SMS, emails)
                          </p>
                        </div>
                      </div>
                    </div>
                    
                    <div className="overflow-x-auto">
                      <table className="w-full">
                        <thead className="bg-gray-50 border-b border-gray-200">
                          <tr>
                            <th className="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rank</th>
                            <th className="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agent</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Total Comms</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Calls</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">SMS</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Emails</th>
                            <th className="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Response Rate</th>
                          </tr>
                        </thead>
                        <tbody className="bg-white divide-y divide-gray-200">
                          {acqLeaderboardData
                            .sort((a, b) => b.communications.total - a.communications.total)
                            .map((agent, index) => (
                            <tr 
                              key={`comm-${agent.userId}`} 
                              className={`hover:bg-gray-50 transition-colors ${
                                isACQ && agent.userId === user?.id ? 'bg-green-50 ring-2 ring-green-200' : ''
                              }`}
                            >
                              <td className="px-6 py-4 whitespace-nowrap">
                                <span className="text-sm font-semibold text-gray-600">#{index + 1}</span>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap">
                                <div className="flex items-center">
                                  <div className="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-xs font-semibold mr-3">
                                    {agent.name.split(' ').map((n: string) => n[0]).join('').toUpperCase()}
                                  </div>
                                  <div>
                                    <div className="text-sm font-medium text-gray-900 flex items-center gap-2">
                                      {agent.name}
                                      {isACQ && agent.userId === user?.id && (
                                        <span className="px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">You</span>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-lg font-bold text-gray-900">{agent.communications.total}</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-sm font-semibold text-blue-600">{agent.communications.calls}</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-sm font-semibold text-purple-600">{agent.communications.sms}</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className="text-sm font-semibold text-orange-600">{agent.communications.emails}</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-center">
                                <div className={`text-sm font-semibold ${
                                  agent.communications.responseRate > 80 ? 'text-green-600' :
                                  agent.communications.responseRate > 60 ? 'text-yellow-600' : 'text-red-600'
                                }`}>
                                  {agent.communications.responseRate}%
                                </div>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </Card>
                </div>
              )}

              {/* No Data State */}
              {!acqLeaderboardLoading && !acqLeaderboardError && acqLeaderboardData.length === 0 && (
                <Card className="p-8 text-center">
                  <div className="space-y-4">
                    <div className="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto">
                      <Trophy className="w-8 h-8 text-gray-400" />
                    </div>
                    <div>
                      <h3 className="text-lg font-semibold text-gray-900 mb-2">No Leaderboard Data</h3>
                      <p className="text-gray-600">
                        No acquisitions performance data available for the selected period.
                      </p>
                      <p className="text-sm text-gray-500 mt-2">
                        Try selecting a different time period or check back later.
                      </p>
                    </div>
                  </div>
                </Card>
              )}
            </>
          )}
        </div>
      )}

      {/* Dispositions Leaderboard Tab */}
      {activeTab === "dispositions-leaderboard" && (
        <div className="space-y-6">
          <div className="flex items-center justify-between">
            <div>
              <h2 className="text-2xl font-bold text-gray-900">Dispositions Leaderboard</h2>
              <p className="text-sm text-gray-600">
                {isDisp ? 'See where you rank among the dispositions team' : 
                 'Rankings and performance comparison for dispositions team'}
              </p>
            </div>
            <div className="flex items-center gap-4">
              <Select value={dispLeaderboardPeriod} onValueChange={setDispLeaderboardPeriod}>
                <SelectTrigger className="w-32">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="this-month">This Month</SelectItem>
                  <SelectItem value="last-month">Last Month</SelectItem>
                  <SelectItem value="this-quarter">This Quarter</SelectItem>
                  <SelectItem value="this-year">This Year</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
          
          {/* Role-based Access Control */}
          {!(isAdmin || isExecutive || isManager || isDisp) ? (
            <Card className="p-8 text-center border-red-200 bg-red-50">
              <div className="space-y-4">
                <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto">
                  <Trophy className="w-8 h-8 text-red-400" />
          </div>
                <div>
                  <h3 className="text-lg font-semibold text-red-900 mb-2">Access Restricted</h3>
                  <p className="text-red-700">
                    Dispositions Leaderboard is available to Admin, Executive, Manager, and Dispositions Agent roles only.
                  </p>
                  <p className="text-sm text-red-600 mt-2">
                    Contact your administrator for access to leaderboard rankings.
                  </p>
        </div>
              </div>
            </Card>
          ) : (
            <>
          {/* Role-based Access Info */}
          <Card className="p-4 bg-gradient-to-r from-purple-50 to-pink-50 border-purple-200">
            <div className="flex items-center justify-between">
              <div className="flex items-center space-x-3">
                <Trophy className="w-5 h-5 text-purple-600" />
                <div>
                  <span className="text-sm font-medium text-gray-700">Leaderboard View: </span>
                  <span className="text-sm font-semibold text-gray-900">
                    {isDisp ? 'Personal Ranking' : 'Team Rankings'}
                  </span>
                </div>
              </div>
              <div className="text-xs text-gray-600">
                {isAdmin ? 'Admin' : isExecutive ? 'Executive' : isManager ? 'Manager' : 
                 isDisp ? 'DISP Agent' : 'User'} Access
              </div>
            </div>
          </Card>

          {/* Loading State */}
          {dispLeaderboardLoading && (
            <Card className="p-8 text-center">
              <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600 mx-auto mb-4"></div>
              <p className="text-gray-600">Loading dispositions leaderboard...</p>
            </Card>
          )}

          {/* Error State */}
          {dispLeaderboardError && (
            <Card className="p-8 text-center border-red-200 bg-red-50">
              <div className="text-red-600 mb-2">⚠️ Error Loading Leaderboard</div>
              <p className="text-red-700">{dispLeaderboardError}</p>
            </Card>
          )}

          {/* No Data State */}
          {!dispLeaderboardLoading && !dispLeaderboardError && dispLeaderboardData.length === 0 && (
            <Card className="p-8 text-center">
              <div className="space-y-4">
                <div className="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto">
                  <Trophy className="w-8 h-8 text-gray-400" />
                </div>
                <div>
                  <h3 className="text-lg font-semibold text-gray-900 mb-2">No Leaderboard Data</h3>
                  <p className="text-gray-600">
                    No dispositions performance data available for the selected period.
                  </p>
                  <p className="text-sm text-gray-500 mt-2">
                    Try selecting a different time period or check back later.
                  </p>
                </div>
              </div>
            </Card>
          )}

          {/* Leaderboard Content Placeholder - Will show when data is available */}
          {!dispLeaderboardLoading && !dispLeaderboardError && dispLeaderboardData.length > 0 && (
            <Card className="p-8 text-center">
              <div className="space-y-4">
                <div className="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto">
                  <Trophy className="w-8 h-8 text-purple-600" />
                </div>
                <div>
                  <h3 className="text-lg font-semibold text-gray-900 mb-2">Dispositions Leaderboard Ready!</h3>
                  <p className="text-gray-600">
                    Found {dispLeaderboardData.length} dispositions agents with performance data.
                  </p>
                  <p className="text-sm text-gray-500 mt-2">
                    Full leaderboard tables will be implemented here.
                  </p>
                </div>
              </div>
            </Card>
          )}
            </>
          )}
        </div>
      )}
    </div>
  );
};

export default Metrics;