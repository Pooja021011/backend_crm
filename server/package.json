{
  "name": "real-estate-crm-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:test": "tsx prisma/seed-test-data.ts",
    "seed:all": "npm run seed && npm run seed:test",
    "lint": "eslint .",
    "postinstall": "node scripts/auto-deploy.js",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate && pm2 restart all --update-env",
    "db:reset": "prisma migrate reset --force && npm run prisma:generate && pm2 restart all",
    "db:fresh": "rm -rf node_modules/@prisma node_modules/.prisma && npm install",
    "server:restart": "pm2 restart all --update-env"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@types/node-cron": "^3.0.11",
    "argon2": "^0.43.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^128.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-imap": "^0.9.6",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.15.0",
    "pino": "^9.0.0",
    "pino-http": "^9.0.0",
    "swagger-ui-express": "^5.0.1",
    "telnyx": "^2.1.1",
    "uuid": "^9.0.1",
    "yaml": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.2.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.17.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.0.0",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5"
  }
}
